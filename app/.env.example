# Leave VITE_CONTRACT_ID empty to run the in-browser demo (no chain, no wallet needed).
VITE_NEAR_NETWORK=testnet
VITE_CONTRACT_ID=
VITE_USDC_ID=
# Gaurav's quote server (HANDOFF_ADITYA.md §5). Without it, the chain renders from local
# pricing but trading is disabled, because only the agent can sign quotes.
VITE_AGENT_URL=
# Optional; defaults to FastNEAR for the network.
VITE_NEAR_RPC_URL=
