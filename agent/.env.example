# Copy to agent/.env (ignored by git). Never commit real keys.
NEAR_NETWORK=testnet
# Optional; defaults to FastNEAR for the network.
NEAR_RPC_URL=

# The deployed twooptions contract and the USDC token it was initialised with.
# For a fresh testnet setup pick sub-accounts of the owner, e.g. twooptions.you.testnet and
# usdc.you.testnet; `python -m twooptions_agent.admin bootstrap` creates and deploys both.
TWOOPTIONS_CONTRACT_ID=
TWOOPTIONS_USDC_ID=

# Signs quotes, spot and funding updates. Its public key must be registered on the contract
# (`new` or `set_agent_keys`). Generate one with `python -m twooptions_agent.admin keygen`.
AGENT_PRIVATE_KEY=

# Pays gas for post_spot, settle_funding and liquidate. Any funded account; it holds no
# authority over funds. It needs a small deposit in the contract to receive liquidation rewards
# (`admin fund-keeper`). Leave KEEPER_ACCOUNT_ID empty and pass --no-keeper to serve quotes only.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# Only for `twooptions_agent.admin` (deploy, set_params, add_series). Not needed by the server.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# Browser origins allowed to call the API, comma separated. `*` allows any.
TWOOPTIONS_CORS_ORIGINS=http://localhost:3001
HOST=127.0.0.1
PORT=8787
# Where funding history and the liquidation watch list are kept.
TWOOPTIONS_DATA_DIR=data

# Pricing. Defaults: 1/24 of time value per hour; ATM vols BTC 0.5, ETH 0.6, SOL 0.8, NEAR 0.9.
# TWOOPTIONS_FUNDING_FRACTION=0.0416666667
# TWOOPTIONS_VOL_ETH=0.6
# TWOOPTIONS_QUOTE_TTL_S=30

# Shown by GET /attestation once the agent runs inside a TEE (#34).
# TWOOPTIONS_CODE_HASH=
# TWOOPTIONS_TEE_QUOTE_URL=
